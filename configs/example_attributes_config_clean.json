            "hard_hat": 0,
            "no_hard_hat": 1
          },
          "confidence_thresholds": {
            "hard_hat": 0.3,
            "no_hard_hat": 0.3
          },
          "time_thresholds": {
            "hard_hat": {
              "min_time_ms": 50,
              "confirm_time_ms": 100
            },
            "no_hard_hat": {
              "min_time_ms": 50,
              "confirm_time_ms": 100
            }
          },
          "ema_alpha": 0.7
        }
      }
    },
    
    "explanation": {
      "attributes_classifier": "Конфигурация для AttributeClassifier - только параметры YOLO детекции",
      "objects_handler.attributes_detection.classifier": "Конфигурация для AttributeManager - параметры управления состояниями атрибутов",
      "no_duplication": "Нет дублирования - каждый параметр используется только в одном месте"
