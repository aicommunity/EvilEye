{
  "example_clean_attributes_config": {
    "description": "Пример чистой конфигурации атрибутов без дублирования",
    
    "attributes_classifier": [
      {
        "source_ids": [0],
        "enabled": true,
        "model": "models/y8mhardhats.pt",
        "attrs": ["hard_hat", "no_hard_hat"],
        "class_mapping": {
          "hard_hat": 0,
          "no_hard_hat": 1
        },
        "conf_threshold": 0.3
      }
