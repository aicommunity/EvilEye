# Normalize line endings: text is LF in the repository and in working copies.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
*.pt binary
*.pth binary
*.onnx binary
*.mp4 binary
*.avi binary
*.mkv binary
