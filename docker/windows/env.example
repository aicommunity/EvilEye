# Copy to .env next to docker-compose or export before Start-EvilEye.ps1
# On Windows use absolute paths, for example:
# EVILEYE_HOST_DATA=C:\EvilEye\EvilEyeData
# EVILEYE_HOST_VIDEOS=C:\EvilEye\videos
# EVILEYE_HOST_MODELS=C:\EvilEye\models
# EVILEYE_HOST_CONFIGS=C:\EvilEye\configs
# EVILEYE_HOST_LOGS=C:\EvilEye\logs
# EVILEYE_HOST_CREDENTIALS=C:\EvilEye\credentials.json
# EVILEYE_HOST_PORT=8181
# EVILEYE_PG_PORT=5432
