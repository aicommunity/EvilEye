# Optional overrides for docker-compose.yml (repo layout)
# EVILEYE_IMAGE=evileye/app:latest   # or evileye/app:cpu
# EVILEYE_SITE_DIR=..                # relative to docker/; default is parent (repo root)
# EVILEYE_HOST_PORT=8181
# EVILEYE_PG_PORT=5432
# EVILEYE_PG_DATA=../postgres_data
# POSTGRES_PASSWORD=postgres
